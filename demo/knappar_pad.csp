// Tre växlande knappar och tre lysdioder.
//   röd  : någon knapp är hög
//   gul  : exakt en knapp är hög
//   grön : alla tre knapparna är höga

#digital B1 in pulldown 2
#digital B2 in pulldown 3
#digital B3 in pulldown 4
#digital Red    out 11
#digital Yellow out 12
#digital Green  out 13
#variable V1:1
#variable V2:1
#variable V3:1
#variable B1Press:1 = 0
#variable B2Press:1 = 0
#variable B3Press:1 = 0

#annotate panel B1 kind=push group=kp
#annotate panel B2 kind=push group=kp
#annotate panel B3 kind=push group=kp
#annotate panel kp kind=keypad buttons="B1,B2,B3" layout="1x3"
#annotate varp assume "[LTE 1](B1, B2, B3)"

#annotate panel Red    color=red
#annotate panel Yellow color=yellow
#annotate panel Green  color=green

#when B1 && !B1Press
      B1Press=1
      V1 = !V1
#end
#when !B1 && B1Press
      B1Press=0
#end

#when B2 && !B2Press
      B2Press=1
      V2 = !V2
#end
#when !B2 && B2Press
      B2Press=0
#end

#when B3 && !B3Press
      B3Press=1
      V3 = !V3
#end
#when !B3 && B3Press
      B3Press=0
#end

Red    = V1 || V2 || V3
Yellow = V1 + V2 + V3 == 1
Green  = V1 && V2 && V3
