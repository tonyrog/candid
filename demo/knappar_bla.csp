// Tre växlande knappar och tre lysdioder.
//   röd  : någon knapp är hög
//   gul  : exakt en knapp är hög
//   grön : alla tre knapparna är höga

#digital B1 in pulldown 2
#digital B2 in pulldown 3
#digital B3 in pulldown 4
#digital Red    out 11
#digital Yellow out 12
#digital Green  out 13

#variable F1:1
#variable F2:1
#variable F3:1
#variable F4:1

#annotate panel B1 kind=toggle
#annotate panel B2 kind=toggle
#annotate panel B3 kind=toggle
#annotate panel Red    color=red
#annotate panel Yellow color=yellow
#annotate panel Green  color=green
#annotate varp inputs "B1 B2 B3: low, down <= 1, events <= 1"

F1 = 1 ? B1 || B2 || B3
F2 = 1 ? B1 + B2 + B3 == 1
F3 = 1 ? B1 && B2 && B3
F4 = 1 ? (B1 || B3) && !(B1 && B2)

Red    =  F1
Yellow =  F2
Green  =  F3

// blå: B1 eller B3, men inte när B1 och B2 är höga samtidigt
#digital Blue out 14
#annotate panel Blue color=blue
Blue   = F4
